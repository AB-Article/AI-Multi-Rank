# Byte-compiled / cache
__pycache__/
*.py[cod]
.venv/
venv/

# Run logs are regenerated by run_all.sh; the archived ones under results/ are
# tracked deliberately, so only stray top-level logs are ignored here.
/*.log
nohup.out

# Upstream clones made by 00_fetch_data.py (their extracts are already in data/)
data/upstream/
data/*_raw/.cache/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
